# Copy to .env and adjust. Never commit .env.
DEBUG=False

FLASK_APP=run.py
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

ASSETS_ROOT=/static/assets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Without DB_ENGINE/DB_NAME/DB_USERNAME the app falls back to a local SQLite file.
# DB_ENGINE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=guion
# DB_USERNAME=guion
# DB_PASS=
